# Copy to .env and choose your own local passwords. .env is never committed.

# Password for the SYS and SYSTEM admin accounts.
ORACLE_PASSWORD=change-me-admin

# Application schema the API connects as. It is created in FREEPDB1 on first start.
ORACLE_APP_USER=risk_app
ORACLE_APP_PASSWORD=change-me-app

# Set to true to log every SQL statement the app runs, with its bind values.
SQL_ECHO=false
